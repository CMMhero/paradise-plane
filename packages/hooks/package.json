{
  "name": "@plane/hooks",
  "version": "2.7.0",
  "private": true,
  "description": "React hooks that are shared across multiple apps internally",
  "license": "AGPL-3.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch --no-clean",
    "check:lint": "vp lint --max-warnings=7 .",
    "check:types": "tsc --noEmit",
    "check:format": "vp fmt --check .",
    "fix:lint": "vp lint --fix .",
    "fix:format": "vp fmt .",
    "clean": "rm -rf .turbo && rm -rf .next && rm -rf node_modules && rm -rf dist"
  },
  "dependencies": {
    "react": "catalog:"
  },
  "devDependencies": {
    "@plane/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
