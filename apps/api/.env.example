# Backend
# Debug value for api server use it as 0 for production use
DEBUG=0
# ⚠️ Aplikasi web dev berjalan di port 4000, BUKAN 3000. Kalau 4000 tidak ada di
# daftar ini, peramban memblokir setiap panggilan API dan gejalanya menyesatkan:
# halaman terbuka tapi kosong atau berputar terus, dan satu-satunya petunjuk ada
# di konsol peramban sebagai galat CORS. Upstream memakai 3000; port di sini
# sengaja digeser, jadi daftar bawaannya ikut digeser.
CORS_ALLOWED_ORIGINS="http://localhost:4000,http://localhost:3001,http://localhost:3002,http://localhost:3100"

# Nama host yang boleh melayani request. Django menolak `Host:` di luar daftar
# ini dengan 400 Bad Request. Kosong berarti `*` (lihat settings/common.py).
#
# ⚠️ Tiap kali menambah nama host di SITE_ADDRESS (.env root), nama itu WAJIB
# ikut ditambahkan di sini. Kalau terlewat, gejalanya menyesatkan: halaman `/`
# tetap 200 karena itu cuma cangkang SPA, tapi setiap panggilan API membalas
# 400 dan aplikasinya tidak jalan sama sekali lewat nama baru itu. Yang memakai
# alamat lama tidak terpengaruh, jadi masalahnya mudah luput dari pengujian.
# Sudah kejadian 12 Agt 2026.
#
# Pertahankan alamat lama di daftar supaya akses lewat IP tidak ikut mati:
#   ALLOWED_HOSTS=space.paradiseperkasa.com,128.159.110.5,localhost
#
# ⚠️ NAMA CONTAINER `api` WAJIB IKUT, dan ini yang paling mudah terlewat.
# `live` memanggil API lewat `http://api:8000` (lihat API_BASE_URL di compose),
# jadi Host yang dikirim adalah `api:8000`, bukan nama domain. Tanpa `api` di
# daftar ini, Django membalas 400 untuk SETIAP panggilan antar-container.
#
# Gejalanya jahat karena tidak terlihat sebagai kerusakan: aplikasi terbuka
# normal, semua halaman 200, tapi kolaborasi Pages dan obrolan real-time diam
# total. Soket menutup sambungan dengan "Tidak berhak" bahkan untuk orang yang
# benar-benar berhak, dan tidak ada satu pun error yang menunjuk ke sini.
# Sudah kejadian 18 Agt 2026, ketahuan hanya karena diuji dengan sesi sungguhan.
#
#   ALLOWED_HOSTS=space.paradiseperkasa.com,128.159.110.5,localhost,api
#
# Bawaannya `*` supaya menyamai default kode; template tidak boleh lebih ketat
# dari kodenya, kalau tidak instalasi baru mati sendiri di request pertama.
# Persempit di produksi, tapi sebutkan SEMUA nama yang benar-benar dipakai,
# termasuk nama internal antar-container.
ALLOWED_HOSTS="*"

# Database Settings
POSTGRES_USER="plane"
POSTGRES_PASSWORD="plane"
POSTGRES_HOST="plane-db"
POSTGRES_DB="plane"
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis Settings
REDIS_HOST="plane-redis"
REDIS_PORT="6379"
REDIS_URL="redis://${REDIS_HOST}:6379/"

# RabbitMQ Settings
RABBITMQ_HOST="plane-mq"
RABBITMQ_PORT="5672"
RABBITMQ_USER="plane"
RABBITMQ_PASSWORD="plane"
RABBITMQ_VHOST="plane"

# AWS Settings
AWS_REGION=""
AWS_ACCESS_KEY_ID="access-key"
AWS_SECRET_ACCESS_KEY="secret-key"
# Alamat MinIO dari DALAM container API, jadi nama service Docker, bukan
# localhost. `localhost` di sini berarti container API itu sendiri, dan unggahan
# gagal dengan galat sambungan yang tidak menyebut MinIO sama sekali.
AWS_S3_ENDPOINT_URL="http://plane-minio:9000"
# Changing this requires change in the proxy config for uploads if using minio setup
AWS_S3_BUCKET_NAME="uploads"
# Maximum file upload limit
FILE_SIZE_LIMIT=5242880
# Signed URL expiration time in seconds (default: 3600 = 1 hour)
# Set to 30 for 30 seconds, 300 for 5 minutes, etc.
SIGNED_URL_EXPIRATION=3600

# Settings related to Docker
DOCKERIZED=1 # deprecated

# set to 1 If using the pre-configured minio setup
USE_MINIO=1

# Alamat MinIO yang dilihat PERAMBAN pada URL presigned. Di dev tidak ada proxy
# yang meneruskan /uploads, jadi tanpa baris ini peramban menerima tautan
# berisi `plane-minio:9000`, nama yang cuma dikenal di dalam jaringan Docker,
# lalu setiap lampiran dan avatar gagal dimuat. Kosongkan di produksi.
MINIO_PUBLIC_ENDPOINT_URL="http://localhost:9000"

# Email redirections and minio domain settings
WEB_URL="http://localhost:4000"

# Gunicorn Workers
GUNICORN_WORKERS=2

# Base URLs
ADMIN_BASE_URL="http://localhost:3001"
ADMIN_BASE_PATH="/god-mode"

SPACE_BASE_URL="http://localhost:3002"
SPACE_BASE_PATH="/spaces"

APP_BASE_URL="http://localhost:4000"
APP_BASE_PATH=""

LIVE_BASE_URL="http://localhost:3100"
LIVE_BASE_PATH="/live"

LIVE_SERVER_SECRET_KEY="secret-key"

# Sinkronisasi Google Calendar. MATI secara bawaan karena fitur ini menulis ke
# kalender pribadi orang; menyalakannya harus tindakan sadar, bukan efek samping
# sebuah deploy. Sesudah diubah wajib `docker compose up -d`, karena `restart`
# tidak membaca ulang env file.
ENABLE_GOOGLE_CALENDAR_SYNC=0

# Kredensial OAuth untuk Google Calendar. Boleh diisi di sini, atau di God Mode
# yang menang atas nilai ini. SENGAJA terpisah dari GOOGLE_CLIENT_ID milik login
# Google: keduanya butuh scope berbeda, dan menggabungkannya berarti setiap
# orang yang login lewat Google ikut dimintai izin kalender.
#
# Di Google Cloud Console: aktifkan Google Calendar API, buat OAuth Client ID
# tipe Web, lalu daftarkan Authorized redirect URI PERSIS seperti ini:
#   https://<host>/api/google-calendar/callback/
# Beda satu garis miring pun ditolak `redirect_uri_mismatch`, dan pesannya tidak
# menyebut bagian mana yang berbeda.
#
# ⚠️ Akun non-Workspace: scope kalender menuntut verifikasi aplikasi oleh Google.
# Tanpa verifikasi, batasnya 100 pengguna dan setiap orang melihat layar
# peringatan "Google belum memverifikasi aplikasi ini" saat menyambungkan.
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""

# Berapa lama barang ter-soft-delete disimpan sebelum dibuang permanen oleh
# tugas harian. Nilai inilah yang menentukan isi Trashbin per project dan TPA
# di God Mode.
#
# HARUS SAMA dengan .env.example di root. Keduanya pernah menyimpang: root
# diturunkan ke 30 oleh commit 641bed9 sedangkan berkas ini tertinggal di 60,
# dan server diprovisikan dari berkas ini sehingga produksi diam-diam berjalan
# di 60 selama dua belas hari tanpa ada yang menyadarinya.
#
# Menurunkannya membuat barang yang sudah lewat batas baru langsung terbuang
# pada jalan berikutnya. Periksa dulu isinya sebelum mengecilkan angka ini.
HARD_DELETE_AFTER_DAYS=30

# Force HTTPS for handling SSL Termination
MINIO_ENDPOINT_SSL=0

# API key rate limit
API_KEY_RATE_LIMIT="60/minute"

# Frasa konfirmasi untuk MEMBERI Super Admin dari God Mode (God Mode -> Member).
# Kosong/tidak diset = pemberian Super Admin DITOLAK. Isi dengan frasa milikmu
# sendiri; jangan pernah menaruh frasa sungguhan di berkas ini (ter-track git).
SUPER_ADMIN_GRANT_PASSPHRASE=""

# ============================================================================
# TINGKATAN LANGGANAN, REM KOLAM GRATIS, DAN BIDANG KENDALI
# ============================================================================
#
# Tingkatan menempel di WORKSPACE, bukan di instance. Alasannya di
# plane/db/models/plan.py: instance itu singleton, jadi menempelkannya di sana
# membuat satu kolam gratis berisi ribuan pemakai hanya punya satu tingkatan.
#
# Workspace tanpa baris WorkspacePlan dianggap gratis. Jadi instance
# pasang-sendiri yang tidak peduli tingkatan tetap berjalan tanpa menyetel
# satu pun variabel di bawah, dan tanpa backfill apa pun.
#
# Ubah tingkatan sebuah workspace tanpa bidang kendali:
#   python manage.py set_workspace_plan <slug> --tier PRO

# Batas tingkatan gratis. FREE_MAX_MEMBERS=1 berarti PERORANGAN: pemiliknya
# sendiri sudah memenuhi kursinya, jadi undangan ditolak sejak dikirim.
# Kolaborasi adalah alasan naik ke Pro. Keputusan pemilik produk 28 Agt 2026.
#
# Kursi yang dihitung mencakup undangan yang BELUM dijawab, kalau tidak satu
# kursi tersisa bisa dipakai mengundang sepuluh orang sekaligus. Yang mahal di kolam gratis BUKAN barisnya melainkan
# berkasnya: 79 orang dengan pemakaian nyata dua bulan di produksi Paradise
# menghasilkan database 598 KB ter-gzip tapi 95 MB unggahan. Jadi rem yang
# paling berpengaruh adalah FREE_MAX_STORAGE_BYTES.
FREE_MAX_MEMBERS=1
FREE_MAX_STORAGE_BYTES=1073741824
FREE_MAX_WORKSPACES=1

# Rem 4: tolak pembuatan workspace sampai surelnya terverifikasi. MATI secara
# bawaan, dan sebaiknya tetap mati di instance pasang-sendiri: instance tanpa
# SMTP tidak akan pernah bisa memverifikasi siapa pun, dan menyalakannya di sana
# berarti tidak ada yang bisa membuat workspace selamanya. Kolam gratis yang
# menyalakannya.
REQUIRE_EMAIL_VERIFICATION_FOR_WORKSPACE=0

# Rem 3: workspace gratis yang lama menganggur. Tiga tahap, dan nol berarti
# tahap itu mati. Tahap ketiga hanya MENANDAI, tidak pernah menghapus:
# penghapusan data pelanggan lewat timer tidak bisa dibatalkan dan tidak
# dijalankan tanpa manusia. Yang berbayar tidak pernah ditidurkan.
DORMANT_WARN_AFTER_DAYS=60
DORMANT_FREEZE_AFTER_DAYS=90
DORMANT_MARK_DELETION_AFTER_DAYS=180

# Bidang kendali. HANYA di deployment milik pemilik produk. Menyalakannya
# memasang aplikasi `plane.control` beserta tabel perusahaan, langganan, dan
# pemakaian, plus rute /control/. Di instance pelanggan biarkan 0: tabelnya
# bahkan tidak akan pernah dibuat.
ENABLE_CONTROL_PLANE=0

# Gerbang aturan staf/divisi (KEP-23/24/25).
# 1 = staf hanya bisa assign diri sendiri (auto-assign saat create, terkunci
# sesudahnya), hanya bisa edit tugas miliknya, dan tugasnya menunggu persetujuan
# atasan (supervisor/manager/direktur) dengan chip "belum disetujui".
# 0 = MATI total: perilaku 88 user tidak berubah satu pun (default aman).
# WAJIB `docker compose up -d` sesudah mengubah (restart tidak baca env ulang).
HIERARKI_GERBANG_TUGAS=1
# Sisi PENYEWA dari denyut. Kosongkan di kolam gratis, di instance
# pasang-sendiri, dan di mesin pengembang; tanpa keduanya task denyut berhenti
# tanpa satu permintaan pun. Yang keluar dari instance hanya tiga angka
# (jumlah workspace, jumlah anggota, byte terpakai) dan versinya. Tidak ada nama
# orang, judul pekerjaan, atau isi berkas.
CONTROL_PLANE_URL=""
CONTROL_PLANE_SECRET=""

# --- Penagihan (Xendit) -----------------------------------------------------
#
# HANYA di deployment pemilik. Instance pelanggan tidak pernah menagih siapa pun.
#
# Xendit dipilih 28 Agt 2026 dari dua kandidat yang sama-sama disetujui pemilik
# produk. Kalau nanti pindah ke Midtrans, yang perlu diganti cuma
# plane/control/xendit.py dan bentuk muatan webhooknya.
#
# Kunci rahasia dari dashboard Xendit. Tanpa ini penerbitan tagihan menolak jalan
# dengan pesan yang menyebut apa yang kurang, dan barisnya dibatalkan supaya
# tidak ada tagihan menggantung yang menandai pelanggan menunggak padahal tidak
# ada yang pernah menagih mereka.
XENDIT_SECRET_KEY=""

# Token verifikasi webhook, disalin dari dashboard Xendit.
#
# KOSONG BERARTI MENOLAK SEMUA WEBHOOK, bukan menerima semua. Instance yang belum
# disetel lebih baik kehilangan webhook daripada menerima perintah "tandai lunas"
# dari siapa pun yang menemukan alamatnya.
#
# Alamat yang didaftarkan di dashboard: https://<panel>/control/payments/xendit/
XENDIT_CALLBACK_TOKEN=""

# Harga daftar per bulan, rupiah bulat. INI TEMPAT DUDUK, bukan harga yang sudah
# diputuskan; per 28 Agt 2026 pemilik produk belum menetapkannya. FREE tidak
# ditagih dan ENTERPRISE ditagih lewat kesepakatan, jadi keduanya tidak ada di
# sini dan memang tidak boleh ada.
PRICE_PRO_IDR=499000
PRICE_EXPERT_IDR=1499000

# Panjang periode, tenggat bayar, dan tenggang sebelum ditangguhkan. Tenggang
# bukan nol karena transfer antar bank bisa butuh satu hari kerja untuk terbaca,
# dan menangguhkan pelanggan yang uangnya sedang di jalan adalah cara kehilangan
# pelanggan yang justru sudah membayar.
BILLING_PERIOD_DAYS=30
BILLING_DUE_DAYS=7
BILLING_GRACE_DAYS=7
