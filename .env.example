# Namespace pemilik image di GHCR, WAJIB huruf kecil dan WAJIB diisi. Dibaca
# oleh docker-compose.ghcr.yml dan paradise/bin/tunggu-latest.sh.
#
# Tidak ada nilai bawaan. Dibiarkan kosong, `docker compose` berhenti dengan
# pesan yang menyebut nama variabel ini, jadi salahnya ketahuan sebelum
# menyentuh container yang sedang melayani.
#
# Isi SESUDAH image di namespace itu benar-benar ada beserta tag `latest`-nya.
# Kalau diisi lebih dulu, `docker compose pull` gagal dan rilisnya batal.
GHCR_OWNER=

# Database Settings
POSTGRES_USER="plane"
POSTGRES_PASSWORD="plane"
POSTGRES_DB="plane"
PGDATA="/var/lib/postgresql/data"

# Redis Settings
REDIS_HOST="plane-redis"
REDIS_PORT="6379"

# RabbitMQ Settings
RABBITMQ_HOST="plane-mq"
RABBITMQ_PORT="5672"
RABBITMQ_USER="plane"
RABBITMQ_PASSWORD="plane"
RABBITMQ_VHOST="plane"

LISTEN_HTTP_PORT=80
LISTEN_HTTPS_PORT=443

# AWS Settings
AWS_REGION=""
AWS_ACCESS_KEY_ID="access-key"
AWS_SECRET_ACCESS_KEY="secret-key"
AWS_S3_ENDPOINT_URL="http://plane-minio:9000"
# Endpoint MinIO yang dilihat browser pada URL presigned. KOSONGKAN di produksi:
# proxy sudah meneruskan /uploads ke MinIO, jadi URL ikut host publik. Isi hanya
# saat dev tanpa proxy (mis. "http://localhost:9000"), kalau tidak user di luar
# kantor akan menerima link yang mengarah ke mesinnya sendiri.
MINIO_PUBLIC_ENDPOINT_URL=""
# Changing this requires change in the proxy config for uploads if using minio setup
AWS_S3_BUCKET_NAME="uploads"
# Maximum file upload limit
FILE_SIZE_LIMIT=524288000

# Konversi Materi Wiki (Word/Excel/PowerPoint) jadi PDF supaya bisa dibaca di
# dalam aplikasi. Kosongkan untuk mematikannya; materi Office akan jatuh ke
# tombol unduh berikut alasannya, bukan ke bingkai kosong.
GOTENBERG_URL=http://gotenberg:3000
# Di atas ambang ini konversi tidak dicoba, karena ia berjalan di dalam siklus
# permintaan dan satu berkas raksasa berarti satu worker gunicorn tertahan.
WIKI_PREVIEW_MAX_BYTES=52428800

# Berapa lama barang yang dihapus masih bisa dipulihkan sebelum benar-benar
# dibuang. Menghapus di aplikasi ini bersifat soft-delete: barisnya ditandai
# `deleted_at`, bukan dihilangkan. Task harian `bgtasks/deletion_task.hard_delete`
# (00:00 UTC) yang membuangnya setelah lewat batas ini.
#
# Nilai inilah yang menentukan isi Trashbin per project dan TPA di God Mode.
# Menurunkannya membuat barang yang sudah lewat batas baru langsung terbuang
# pada jalan berikutnya, periksa dulu isinya sebelum mengecilkan angka ini.
HARD_DELETE_AFTER_DAYS=30

# GPT settings
OPENAI_API_BASE="https://api.openai.com/v1" # deprecated
OPENAI_API_KEY="sk-" # deprecated
GPT_ENGINE="gpt-3.5-turbo" # deprecated

# Settings related to Docker
DOCKERIZED=1  # deprecated

# set to 1 If using the pre-configured minio setup
USE_MINIO=1

CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
TRUSTED_PROXIES=0.0.0.0/0

# Alamat yang dilayani Caddy. Boleh lebih dari satu, dipisah koma.
#
# PERTAHANKAN alamat IP di daftar saat menambahkan nama domain. Kalau hanya
# nama domain yang didaftarkan, Caddy berhenti melayani akses lewat IP dan
# siapa pun yang menyimpan bookmark IP langsung terkunci. Sertifikat tetap
# hanya untuk nama domainnya; IP tidak bisa disertifikasi, jadi ia melayani
# HTTP biasa. Contoh produksi:
#   SITE_ADDRESS=space.paradiseperkasa.com, http://128.159.110.5
SITE_ADDRESS=:80

# ⚠️ WAJIB memuat kata `email` di depan alamatnya, BUKAN alamatnya saja:
#   CERT_EMAIL=email orang@perusahaan.com
#
# Isi variabel ini disisipkan MENTAH ke blok opsi global Caddyfile. Alamat
# telanjang dibaca sebagai nama opsi, Caddy menolak SELURUH config dengan
# "unrecognized global option", proxy masuk restart-loop, dan SELURUH aplikasi
# mati, bukan cuma HTTPS-nya. Sudah kejadian 12 Agt 2026.
#
# Aturan yang sama berlaku untuk CERT_ACME_DNS di bawah: ia harus diawali
# `acme_dns`, karena ia juga disisipkan mentah ke blok yang sama.
CERT_EMAIL=

# ⚠️ Saat menambahkan nama host baru di SITE_ADDRESS, nama itu WAJIB ikut
# ditambahkan ke ALLOWED_HOSTS di apps/api/.env. Kalau tidak, Django menolak
# setiap request ber-`Host:` nama baru dengan 400 Bad Request, sementara `/`
# tetap membalas 200 karena itu cuma cangkang SPA. Gejalanya menyesatkan:
# halaman terbuka, aplikasinya tidak jalan. Sudah kejadian 12 Agt 2026.

# For DNS Challenge based certificate generation, set the CERT_ACME_DNS, CERT_EMAIL
# CERT_ACME_DNS="acme_dns <CERT_DNS_PROVIDER> <CERT_DNS_PROVIDER_API_KEY>"
#
# Wajib dipakai kalau server ada di balik NAT: HTTP-01 menuntut Let's Encrypt
# bisa menjangkau server dari internet, dan itu tidak mungkin di sana.
#
# Provider yang terkompilasi di apps/proxy/Dockerfile.ce: cloudflare,
# digitalocean, acmedns. Provider lain butuh satu baris tambahan di situ
# lalu build ulang image.
#
# acme-dns dipakai kalau zona induk tidak punya API yang bisa ditulis Caddy.
# Ia butuh EMPAT kredensial, jadi bentuk satu barisnya menunjuk berkas JSON:
#   CERT_ACME_DNS="acme_dns acmedns /etc/caddy/acmedns.json"
# Berkas itu di-mount dari ACMEDNS_CREDENTIALS_FILE (lihat docker-compose.yml)
# dan HARUS SUDAH ADA sebelum `up -d`. Isinya pipih, bukan berkunci domain:
#   {"username":"...","password":"...","subdomain":"...","server_url":"https://auth.acme-dns.io"}
# Nilainya dari `curl -X POST https://auth.acme-dns.io/register`, lalu satu
# CNAME `_acme-challenge.<host>` menunjuk ke `fulldomain` dari balasan itu.
CERT_ACME_DNS=

# Force HTTPS for handling SSL Termination
MINIO_ENDPOINT_SSL=0

# API key rate limit
API_KEY_RATE_LIMIT="60/minute"

# ── Panggilan suara & video (TURN) ──────────────────────────────────────────
#
# Asumsi awal fitur panggilan adalah "satu kantor, satu LAN, jalur langsung
# antar-peramban sudah cukup". Itu RUNTUH di jaringan nyata: banyak jaringan
# kantor menyalakan isolasi antar-klien di WiFi, dan sebagian memblokir UDP
# antar-perangkat. Saat itu terjadi, WebRTC tidak pernah menemukan jalur dan
# panggilan diam total: SDP bertukar mulus, layar bilang tersambung, tapi tidak
# ada satu byte media pun mengalir. Tidak ada error di mana pun.
#
# TURN menutup lubang itu dengan merelai media lewat server.
#
# TURN_SECRET: rahasia bersama antara coturn dan API. API memakainya untuk
# menghitung kredensial berumur pendek; kalau dua sisi tidak sama, coturn
# menolak alokasi relai dan panggilan gagal tanpa keterangan.
#   openssl rand -hex 32
#
# TURN_URL: alamat yang DIHUBUNGI PERAMBAN, bukan nama container. Peramban
# berjalan di komputer karyawan dan tidak mengenal jaringan Docker.
#   TURN_URL=128.159.110.5:3478
#
# ⚠️ Port 3478 (UDP dan TCP) serta rentang relai 49160-49200/UDP harus terbuka
# di firewall server. Tanpa itu coturn hidup normal tapi relainya tak pernah
# terpakai, dan gejalanya sama persis dengan tidak memasang TURN sama sekali.
TURN_SECRET=
TURN_URL=
TURN_REALM=paradiseperkasa.com

# ── Server panggilan (LiveKit) ──────────────────────────────────────────────
#
# Panggilan TIDAK lagi peer ke peer. Versi pertama memakai RTCPeerConnection
# langsung dan gagal berulang kali di jaringan kantor, karena peer ke peer
# menuntut kedua KOMPUTER bisa saling menghubungi langsung. LiveKit membalik
# arahnya: kedua peramban menyambung KE SERVER, lalu server meneruskan media.
# Jalur komputer ke server sudah pasti terbuka, karena aplikasinya sendiri
# berjalan lewat jalur itu.
#
# LIVEKIT_KEYS dibaca container livekit, formatnya "kunci: rahasia" (ada spasi
# sesudah titik dua). LIVEKIT_API_KEY dan LIVEKIT_API_SECRET dibaca API untuk
# menerbitkan token; nilainya HARUS sama dengan yang di LIVEKIT_KEYS, kalau
# tidak LiveKit menolak setiap token tanpa pesan yang menunjuk sebabnya.
#
#   K=$(openssl rand -hex 8); S=$(openssl rand -hex 32)
#   LIVEKIT_KEYS="$K: $S"
#   LIVEKIT_API_KEY=$K
#   LIVEKIT_API_SECRET=$S
#
# LIVEKIT_URL: alamat yang DIHUBUNGI PERAMBAN, bukan nama container.
#   LIVEKIT_URL=ws://128.159.110.5:7880
#
# ⚠️ Port 7880 (WebSocket), 7881 (TCP media), dan 50000-50200/UDP harus terbuka
# di firewall. Tanpa itu LiveKit hidup normal tapi media tidak pernah mengalir.
#
# ⚠️ `rtc.use_external_ip` di paradise/livekit.yaml HARUS false. Server ini di
# balik NAT; kalau LiveKit menemukan "IP publik" sendiri ia akan mengiklankan
# alamat egress yang tidak bisa dihubungi dari dalam kantor.
LIVEKIT_KEYS=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=
